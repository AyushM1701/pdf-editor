APP_NAME=Hybrid PDF API
API_PREFIX=/api
AWS_REGION=us-east-1
S3_BUCKET_NAME=hybrid-pdf-documents
PRESIGNED_URL_EXPIRATION=900
DOCUMENT_AI_MODEL_NAME=
HF_PIPELINE_TASK=text-classification
HF_DEVICE=-1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
GEMINI_API_KEY=
USE_LOCAL_STORAGE=True
